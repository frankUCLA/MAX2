# MAX — un solo sistema (planes por cupos de cajas)
PORT=3000
CAJA_MAYOR_PORT=3011
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=MAX

# Claves de autorización por plan (copiar igual en cada PC servidor)
LICENCIA_KEY_BASICO=MAX-KEY-BASICO-7701
LICENCIA_MASTER_KEY=MAX-KEY-BASICO-7701
LICENCIA_KEY_STANDARD=MAX-KEY-STANDARD-8802
LICENCIA_KEY_PRO=MAX-KEY-PRO-9903
LICENCIA_KEY_ULTRA=MAX-KEY-ULTRA-0014

# En PCs de caja (no servidor):
# MAX_SERVER_URL=http://192.168.1.100:3000

# App MAX-Móvil (recomendado): Tailscale Funnel da una dirección HTTPS pública
# estable sin comprar dominio. Instala/inicia sesión en Tailscale y habilita
# Funnel, MagicDNS y HTTPS en el tailnet.
# MAX_TUNNEL_PROVIDER=tailscale-funnel
# MAX_MOBILE_URL=https://nombre-pc.nombre-tailnet.ts.net

# Alternativa: Cloudflare Tunnel con dominio propio (ambas variables obligatorias).
# MAX_TUNNEL_PROVIDER=cloudflare
# MAX_TUNNEL_TOKEN=token-secreto-del-tunel
# MAX_MOBILE_URL=https://movil.midominio.com
